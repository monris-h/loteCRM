{
  "name": "lotescrm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed": "node src/scripts/seed.js",
    "db:reset": "node src/scripts/migrate.js --reset && node src/scripts/seed.js --no-ingest",
    "ingest": "node src/scripts/ingest.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}
